# ==============================================================================
# GitHub Enterprise Cloud (GHEC) Platform Governance Advisor - Environment Config
# ==============================================================================

# GHEC API Endpoint
# Default: https://api.github.com
# For GHEC with Enterprise Data Residency, set to: https://api.<company>.ghe.com
GHEC_API_BASE_URL=https://api.github.com

# ------------------------------------------------------------------------------
# GitHub App Authentication Credentials
# ------------------------------------------------------------------------------
# 1. Numeric GitHub App ID (Required)
GHEC_APP_ID=123456

# 2. Installation ID (Optional - Auto-Discovered)
# If left blank or omitted, the application automatically queries GitHub App installations
# for your organization and populates this field dynamically in .env.
GHEC_APP_INSTALLATION_ID=

# 3. GitHub App Private Key (Required - choose either PATH or RAW)
# Option A: Local file path to the RSA private key PEM file (auto-detected from secrets/ if placed there)
GHEC_APP_PRIVATE_KEY_PATH=secrets/gh-governance-advisor.2026-11-03.private-key.pem

# Option B: Raw PEM string or base64 string (ideal for CI/CD pipelines and Kubernetes secrets)
# GHEC_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# Multi-Provider AI Remediation Engine (Optional)
# ------------------------------------------------------------------------------
# Generates tech-stack-tailored Copilot instructions, DevContainers, Dependabot configs,
# and C-suite Executive Risk Briefings.
# If omitted, the agent operates in 100% deterministic offline policy mode.

# Supported providers: 'gemini', 'openai', 'azure', 'anthropic', 'auto'
LLM_PROVIDER=gemini

# Provider API Keys (Set the key corresponding to your LLM_PROVIDER):
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Target Model Identifier:
# Gemini:    gemini-3.5-flash (default), gemini-3.5-flash-lite, gemini-3.8-flash
# OpenAI:    gpt-4o, gpt-4o-mini
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
LLM_MODEL=gemini-3.5-flash
